<Window x:Class="ChudoObuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — система оформления заказа обуви"
        Height="860" Width="1320" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Calibri" FontSize="15"
        Background="{StaticResource MainBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" x:Name="LogoImage" Height="52" Margin="0,0,14,0" />
                <TextBlock Grid.Column="1" x:Name="TitleText" Text="Чудо Обувь"
                           FontSize="26" FontWeight="Bold" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UserInfoText" VerticalAlignment="Center"
                               FontWeight="Bold" Margin="0,0,10,0" />
                    <Button x:Name="BackButton" Content="Назад" Click="Back_Click"
                            Visibility="Collapsed" />
                    <Button x:Name="LogoutButton" Content="Выйти" Click="Logout_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden" />
    </Grid>
</Window>
