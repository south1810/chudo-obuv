<Page x:Class="ChudoObuv.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог товаров"
      FontFamily="Calibri" FontSize="15"
      Background="{StaticResource MainBackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Поиск, фильтрация и сортировка: только для авторизованных -->
        <Grid Grid.Row="0" x:Name="FilterPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Поиск по наименованию, описанию и составу:" />
                <TextBox x:Name="SearchTextBox" TextChanged="Filter_Changed" MaxLength="100" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Категория:" />
                <ComboBox x:Name="CategoryComboBox" SelectionChanged="Filter_Changed" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Сортировка по цене:" />
                <ComboBox x:Name="SortComboBox" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Без сортировки" IsSelected="True" />
                    <ComboBoxItem Content="По возрастанию цены" />
                    <ComboBoxItem Content="По убыванию цены" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Действия -->
        <DockPanel Grid.Row="1" Margin="0,8,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ComboBox x:Name="SizeComboBox" Width="150" VerticalAlignment="Center" />
                <Button x:Name="AddButton" Content="В заказ" Style="{StaticResource AccentButton}"
                        Click="Add_Click" IsEnabled="False" Margin="6,0,0,0" />
                <Button x:Name="CartButton" Content="Корзина" Click="Cart_Click" />
                <Button x:Name="OrdersButton" Content="Список заказов" Click="Orders_Click"
                        Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="OrderClientText" VerticalAlignment="Center"
                       FontStyle="Italic" TextWrapping="Wrap" />
        </DockPanel>

        <!-- Каталог -->
        <ListView Grid.Row="2" x:Name="ProductsListView"
                  SelectionChanged="ProductsListView_SelectionChanged"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  BorderThickness="0" Background="Transparent">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#5A6B72" BorderThickness="1" Padding="8" Margin="0,0,0,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource MainBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource LowStockBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="230" />
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Source="{Binding ImagePath}" Height="110"
                                   Stretch="Uniform" Margin="0,0,14,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CategoryName, StringFormat=Категория: {0}}"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="{Binding QuantityText, StringFormat=Количество: {0}}" />
                                <TextBlock Text="{Binding Composition}" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedBrush}" MaxHeight="52" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="{Binding OldPriceText}" FontSize="15"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextDecorations="Strikethrough"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding PriceText}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="3" x:Name="CounterText" Margin="0,8,0,0"
                   HorizontalAlignment="Right" FontWeight="Bold" />
    </Grid>
</Page>
