<Page x:Class="ChudoObuv.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход в систему"
      FontFamily="Calibri" FontSize="15"
      Background="{StaticResource MainBackgroundBrush}">
    <Grid>
        <Border Width="500" Padding="26" CornerRadius="10"
                Background="{StaticResource SecondaryBackgroundBrush}"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Пароль не требуется — вход выполняется по логину пользователя."
                           FontSize="13" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,16" />

                <TextBlock Text="Логин" />
                <TextBox x:Name="LoginTextBox" Margin="0,4,0,12" MaxLength="50" />

                <Button Content="Войти" Style="{StaticResource AccentButton}"
                        Click="Login_Click" Margin="0,0,0,8" />

                <Button Content="Продолжить как гость" Click="Guest_Click" />

                <TextBlock x:Name="ErrorText" Foreground="#B03030" FontSize="14"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
