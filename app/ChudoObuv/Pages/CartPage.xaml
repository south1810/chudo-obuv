<Page x:Class="ChudoObuv.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Оформление заказа"
      FontFamily="Calibri" FontSize="15"
      Background="{StaticResource MainBackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" Text="Оформление заказа"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Клиент:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="ClientComboBox" Width="380" />
            <TextBlock x:Name="ClientLockedText" VerticalAlignment="Center" Margin="8,0,0,0"
                       FontStyle="Italic" />
        </StackPanel>

        <ListView Grid.Row="2" x:Name="LinesListView" BorderThickness="0" Background="Transparent">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#5A6B72" BorderThickness="1" Padding="8" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="17" />
                                <TextBlock Text="{Binding UnitPriceText, StringFormat=Цена: {0}}"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding SizeText, StringFormat=Размер: {0}}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Кол-во:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                         Width="60" HorizontalContentAlignment="Right" />
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="{Binding SumText}" FontWeight="Bold"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />

                            <Button Grid.Column="4" Content="Удалить" Click="Remove_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Отмена" Click="Cancel_Click" />
                <Button Content="Оформить заказ" Style="{StaticResource AccentButton}"
                        Click="Save_Click" />
            </StackPanel>
            <TextBlock x:Name="TotalText" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Page>
